{
  "name": "thoughtspot-embed-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:clean": "rm -rf node_modules/.vite && vite --force",
    "dev:fresh": "npm install && rm -rf node_modules/.vite && vite --force",
    "build": "tsc -b && vite build",
    "gen:embed-schema": "node scripts/gen-embed-schema.mjs",
    "build:clean": "rm -rf node_modules/.vite dist && find . -name \"*.tsbuildinfo\" -not -path \"./node_modules/*\" -delete && npm run build",
    "preview": "vite preview",
    "gen:rest-catalog": "node scripts/gen-rest-catalog.mjs",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "lint:colors": "node scripts/check-color-literals.mjs",
    "lint": "npm run lint:css && npm run lint:colors"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "codemirror": "^6.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "postcss-scss": "^4.0.9",
    "sass": "^1.101.0",
    "stylelint": "^17.14.1",
    "typescript": "~5.7.2",
    "vite": "^6.3.5"
  }
}
